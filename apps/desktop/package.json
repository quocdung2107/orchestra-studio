{
  "name": "@orchestra/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/mark-cjs.mjs",
    "desktop": "pnpm run build && pnpm run build:electron && electron .",
    "desktop:dev": "pnpm run build:electron && electron . --dev-url=http://127.0.0.1:5173"
  },
  "dependencies": {
    "@orchestra/contracts": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "@xyflow/react": "^12.12.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "main": "dist-electron/main.js"
}
